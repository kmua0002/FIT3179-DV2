{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": 700,
    "height": 360,

    "data": {
        "url": "https://kmua0002.github.io/FIT3179-DV2/data/pokemon_master.csv"
    },

    "encoding": {
        "x": {
        "field": "generation",
        "type": "ordinal",
        "sort": [
            "Generation I",
            "Generation II",
            "Generation III",
            "Generation IV",
            "Generation V",
            "Generation VI",
            "Generation VII",
            "Generation VIII",
            "Generation IX"
        ],
        "title": null,
        "axis": {
            "labelAngle": 0,
            "labelExpr": "replace(datum.label, 'Generation ', 'Gen ')",
            "labelPadding": 8,
            "ticks": false,
            "domain": false
        }
        },

        "y": {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Pokémon introduced",
        "scale": {
            "zero": true
        },
        "axis": {
            "gridColor": "#e5e5e5",
            "domain": false,
            "ticks": false
        }
        }
    },

    "layer": [
        {
        "mark": {
            "type": "bar"
        },

        "encoding": {
            "color": {
            "condition": {
                "test": "datum.generation === 'Generation V'",
                "value": "#FFCB05"
            },
            "value": "#3B4CCA"
            },

            "tooltip": [
            {
                "field": "generation",
                "type": "ordinal",
                "title": "Generation"
            },
            {
                "aggregate": "count",
                "type": "quantitative",
                "title": "Pokémon introduced"
            }
            ]
        }
        },

        {
        "mark": {
            "type": "text",
            "dy": -8,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#222222"
        },

        "encoding": {
            "text": {
            "aggregate": "count",
            "type": "quantitative"
            }
        }
        }
    ],

    "config": {
        "view": {
        "stroke": null
        }
    }
}