
{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "description": "Percentage of Poké Lids featuring at least one Generation I Pokémon, by Japanese prefecture.",

    "width": 700,
    "height": 560,

    "data": {
        "url": "data/geo/japan_prefectures.topojson",
        "format": {
        "type": "topojson",
        "feature": "ne_10m_admin_1_states_provinces"
        }
    },

    "transform": [
        {
        "lookup": "properties.iso_3166_2",
        "from": {
            "data": {
            "url": "data/pokelids_prefecture_gen1.csv"
            },
            "key": "iso_3166_2",
            "fields": [
            "total_lids",
            "gen1_lids",
            "gen1_percent",
            "gen1_percent_label",
            "record_label"
            ]
        }
        },
        {
        "calculate": "isValid(datum.total_lids) && datum.total_lids > 0 ? 'Recorded prefecture' : 'No recorded Poké Lids'",
        "as": "coverage_status"
        }
    ],

    "projection": {
        "type": "mercator"
    },

    "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.1
    },

    "encoding": {
        "color": {
        "condition": {
            "test": "isValid(datum.total_lids) && datum.total_lids > 0",
            "field": "gen1_percent",
            "type": "quantitative",
            "title": "Poké Lids featuring Gen I (%)",
            "scale": {
            "domain": [0, 100],
            "range": [
                "#D6E5FF",
                "#3B4CCA"
            ]
            },
            "legend": {
            "orient": "right",
            "gradientLength": 170,
            "values": [0, 25, 50, 75, 100]
            }
        },
        "value": "#D8DCE4"
        },

        "tooltip": [
        {
            "field": "properties.name",
            "type": "nominal",
            "title": "Prefecture"
        },
        {
            "field": "gen1_percent_label",
            "type": "nominal",
            "title": "Feature Gen I"
        },
        {
            "field": "record_label",
            "type": "nominal",
            "title": "Gen I / Total lids"
        },
        {
            "field": "coverage_status",
            "type": "nominal",
            "title": "Coverage"
        }
        ]
    },

    "config": {
        "view": {
        "stroke": null
        }
    }
}
