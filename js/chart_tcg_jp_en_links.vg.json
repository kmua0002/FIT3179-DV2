        {"en_year":"2024","jp_order":7,"en_mid_order":7.5,"jp_set":"Paradise Dragona","jp_date":"2024-09-13","en_set":"Surging Sparks","en_date":"2024-11-08","delay_days":56},
        {"en_year":"2024","jp_order":8,"en_mid_order":7.5,"jp_set":"Super Electric Breaker","jp_date":"2024-10-18","en_set":"Surging Sparks","en_date":"2024-11-08","delay_days":21}
