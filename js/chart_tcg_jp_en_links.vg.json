    },


    
    "params": [
    {
        "name": "selectedYear",
        "value": "2023",
        "bind": {
        "input": "select",
        "name": "English release year: ",
        "options": ["2023", "2024"]
        }
    }
    ],

    "transform": [
        {
        "filter": "datum.en_year === selectedYear"
        },
        {
        "calculate": "datum.delay_days <= 30 ? '0–30 days' : datum.delay_days <= 60 ? '31–60 days' : 'Over 60 days'",
        "as": "delay_group"
        }
    ],

    "layer": [
        {
        "mark": {
            "type": "rule",
            "strokeWidth": 2.5,
            "opacity": 0.78
        },
        "encoding": {
            "x": {
            "datum": 250,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "x2": {"datum": 480},
            "y": {
            "field": "jp_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "y2": {"field": "en_mid_order"},
            "color": {
            "field": "delay_group",
            "type": "nominal",
            "title": "Gap between launches",
            "scale": {
                "domain": [
                "0–30 days",
                "31–60 days",
                "Over 60 days"
                ],
                "range": [
                "#E4AA26",
                "#8A9ADB",
                "#3B4CCA"
                ]
            },
            "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "labelFontSize": 11,
                "titleFontSize": 11
            }
            },
            "tooltip": [
            {
                "field": "jp_set",
                "type": "nominal",
                "title": "Japanese expansion"
            },
            {
                "field": "jp_date",
                "type": "nominal",
                "title": "Japan release"
            },
            {
                "field": "en_set",
                "type": "nominal",
                "title": "English expansion"
            },
            {
                "field": "en_date",
                "type": "nominal",
                "title": "English release"
            },
            {
                "field": "delay_days",
                "type": "quantitative",
                "title": "Days apart",
                "format": ".0f"
            }
            ]
        }
        },

        {
        "mark": {
            "type": "point",
            "filled": true,
            "size": 130,
            "color": "#3B4CCA",
            "stroke": "#FFFFFF",
            "strokeWidth": 1.5
        },
        "encoding": {
            "x": {
            "datum": 250,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "y": {
            "field": "jp_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "tooltip": [
            {
                "field": "jp_set",
                "type": "nominal",
                "title": "Japanese set"
            },
            {
                "field": "jp_date",
                "type": "nominal",
                "title": "Release date"
            }
            ]
        }
        },

        {
        "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dy": -9,
            "font": "Inter",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#344063"
        },
        "encoding": {
            "x": {
            "datum": 237,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "y": {
            "field": "jp_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "text": {"field": "jp_set"}
        }
        },

        {
        "mark": {
            "type": "text",
            "align": "right",
            "baseline": "middle",
            "dy": 10,
            "font": "Inter",
            "fontSize": 10,
            "color": "#697896"
        },
        "encoding": {
            "x": {
            "datum": 237,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "y": {
            "field": "jp_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "text": {"field": "jp_date"}
        }
        },

        {
        "transform": [
            {
            "aggregate": [
                {"op": "count", "as": "source_count"}
            ],
            "groupby": [
                "en_set",
                "en_date",
                "en_mid_order"
            ]
            }
        ],
        "mark": {
            "type": "point",
            "shape": "diamond",
            "filled": true,
            "size": 165,
            "color": "#FFCB05",
            "stroke": "#8B6A00",
            "strokeWidth": 1
        },
        "encoding": {
            "x": {
            "datum": 480,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "y": {
            "field": "en_mid_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "tooltip": [
            {
                "field": "en_set",
                "type": "nominal",
                "title": "English expansion"
            },
            {
                "field": "en_date",
                "type": "nominal",
                "title": "Release date"
            },
            {
                "field": "source_count",
                "type": "quantitative",
                "title": "Featured Japanese sets",
                "format": ".0f"
            }
            ]
        }
        },

        {
        "transform": [
            {
            "aggregate": [
                {"op": "count", "as": "source_count"}
            ],
            "groupby": [
                "en_set",
                "en_date",
                "en_mid_order"
            ]
            }
        ],
        "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dy": -9,
            "font": "Inter",
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#344063"
        },
        "encoding": {
            "x": {
            "datum": 494,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "y": {
            "field": "en_mid_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "text": {"field": "en_set"}
        }
        },

        {
        "transform": [
            {
            "aggregate": [
                {"op": "count", "as": "source_count"}
            ],
            "groupby": [
                "en_set",
                "en_date",
                "en_mid_order"
            ]
            },
            {
            "calculate": "datum.en_date + ' · ' + datum.source_count + (datum.source_count == 1 ? ' source set' : ' source sets')",
            "as": "release_detail"
            }
        ],
        "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dy": 10,
            "font": "Inter",
            "fontSize": 10,
            "color": "#697896"
        },
        "encoding": {
            "x": {
            "datum": 494,
            "type": "quantitative",
            "scale": {"domain": [0, 740]},
            "axis": null
            },
            "y": {
            "field": "en_mid_order",
            "type": "quantitative",
            "scale": {"domain": [10, -1]},
            "axis": null
            },
            "text": {"field": "release_detail"}
        }
        }
    ],

    "config": {
        "font": "Inter",
        "view": {"stroke": null},
        "legend": {
        "labelColor": "#52617F",
        "titleColor": "#344063"
        }
    }
}
