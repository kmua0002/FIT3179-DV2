        {"en_year":"2023","jp_order":0,"en_mid_order":0.5,"jp_set":"Scarlet ex","jp_date":"2023-01-20","en_set":"Scarlet & Violet","en_date":"2023-03-31","delay_days":70},
        {"en_year":"2023","jp_order":1,"en_mid_order":0.5,"jp_set":"Violet ex","jp_date":"2023-01-20","en_set":"Scarlet & Violet","en_date":"2023-03-31","delay_days":70},
        {"en_year":"2023","jp_order":2,"en_mid_order":3,"jp_set":"Triplet Beat","jp_date":"2023-03-10","en_set":"Paldea Evolved","en_date":"2023-06-09","delay_days":91},
        {"en_year":"2023","jp_order":3,"en_mid_order":3,"jp_set":"Snow Hazard","jp_date":"2023-04-14","en_set":"Paldea Evolved","en_date":"2023-06-09","delay_days":56},
