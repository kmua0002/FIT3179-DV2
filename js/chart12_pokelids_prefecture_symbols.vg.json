{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 560,
    "projection": { "type": "mercator" },
    "layer": [
        {
        "data": {
            "url": "data/geo/japan_prefectures.topojson",
            "format": {
            "type": "topojson",
            "feature": "ne_10m_admin_1_states_provinces"
            }
        },
        "mark": {
            "type": "geoshape",
            "fill": "#EAF0FF",
            "stroke": "#B6C3D9",
            "strokeWidth": 0.7
        },
        "encoding": {
            "tooltip": [
            { "field": "name_en", "type": "nominal", "title": "Prefecture" }
            ]
        }
        },
        {
        "data": { "url": "data/pokelids_locations.csv" },
        "transform": [
            {
            "joinaggregate": [
                { "op": "count", "as": "lid_count" },
                { "op": "median", "field": "latitude", "as": "median_lat" },
                { "op": "median", "field": "longitude", "as": "median_lon" }
            ],
            "groupby": ["prefecture"]
            },
            {
            "calculate": "abs(datum.latitude - datum.median_lat) + 0.8 * abs(datum.longitude - datum.median_lon)",
            "as": "distance_to_middle"
            },
            {
            "window": [ { "op": "row_number", "as": "representative_rank" } ],
            "sort": [ { "field": "distance_to_middle", "order": "ascending" } ],
            "groupby": ["prefecture"]
            },
            { "filter": "datum.representative_rank == 1" }
        ],
        "mark": {
            "type": "circle",
            "color": "#3B4CCA",
            "opacity": 0.78,
            "stroke": "#FFFFFF",
            "strokeWidth": 1.2
        },
        "encoding": {
            "longitude": { "field": "longitude", "type": "quantitative" },
            "latitude": { "field": "latitude", "type": "quantitative" },
            "size": {
            "field": "lid_count",
            "type": "quantitative",
            "title": "Recorded Poké Lids",
            "scale": { "domain": [0, 50], "range": [0, 1400] },
            "legend": { "orient": "right", "values": [5, 15, 30, 50] }
            },
            "tooltip": [
            { "field": "prefecture", "type": "nominal", "title": "Prefecture" },
            { "field": "lid_count", "type": "quantitative", "title": "Recorded Poké Lids", "format": ".0f" }
            ]
        }
        }
    ],
    "config": { "view": { "stroke": null } }
}
