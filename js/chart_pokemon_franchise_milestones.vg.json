        {
            "chart_label": "Pokémon Snap · photography",
            "category": "Spin-off & mobile",
            "plot_year": 1999.2164,
            "year": 1999,
            "date_label": "1999-03-21",
            "description": "Pokémon expands into photography gameplay on Nintendo 64"
        },
        {
            "chart_label": "Mystery Dungeon · roguelike",
            "category": "Spin-off & mobile",
            "plot_year": 2005.8767,
            "year": 2005,
            "date_label": "2005-11-17",
            "description": "Red Rescue Team and Blue Rescue Team launch in Japan"
        },
        {
            "chart_label": "POKÉMON with YOU",
            "category": "Retail & community",
            "plot_year": 2011.2849,
            "year": 2011,
            "date_label": "Apr 2011",
            "description": "Community support initiative begins following the 2011 Japan earthquake and tsunami"
