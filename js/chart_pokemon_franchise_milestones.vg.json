        {
            "chart_label": "Detective Pikachu · live action",
            "category": "Screen & animation",
            "plot_year": 2019.3534,
            "year": 2019,
            "date_label": "2019-05-10",
            "description": "First live-action Pokémon feature film released in North America"
        },
        {
            "chart_label": "Pokémon UNITE · team battle",
            "category": "Spin-off & mobile",
            "plot_year": 2021.5507,
            "year": 2021,
            "date_label": "2021-07-21",
            "description": "5v5 strategic team battle game launches on Nintendo Switch"
        },
        {
            "chart_label": "Pokémon Concierge · stop-motion",
            "category": "Screen & animation",
            "plot_year": 2023.989,
            "year": 2023,
            "date_label": "2023-12-28",
            "description": "Stop-motion Pokémon series debuts internationally"
        },
        {
            "chart_label": "TCG Pocket · digital cards",
            "category": "Trading cards",
            "plot_year": 2024.8279,
            "year": 2024,
            "date_label": "2024-10-30",
            "description": "Digital collecting app for Android and iOS launches"
        },
        {
            "chart_label": "Pokopia · life simulation",
            "category": "Spin-off & mobile",
            "plot_year": 2026.1726,
            "year": 2026,
            "date_label": "2026-03-05",
            "description": "Pokémon life-simulation game launches on Nintendo Switch 2"
        }
        ]
    },
    "params": [
        {
        "name": "categoryFocus",
        "value": "All",
        "bind": {
            "input": "select",
            "name": "Highlight franchise branch: ",
            "options": [
            "All",
            "Original RPG",
            "Manga & print",
            "Trading cards",
            "Screen & animation",
            "Retail & community",
            "Spin-off & mobile"
            ]
        }
        }
    ],
    "encoding": {
        "x": {
        "field": "plot_year",
        "type": "quantitative",
        "scale": {
            "domain": [
            1995,
            2030.5
            ],
            "nice": false
        },
        "axis": {
            "title": "Year of milestone",
            "values": [
            1996,
            2000,
            2005,
            2010,
            2015,
            2020,
            2025
            ],
            "format": ".0f",
            "grid": true,
            "gridColor": "#E8EDF8",
            "labelFontSize": 11,
            "titleFontSize": 12
        }
        },
        "y": {
        "field": "chart_label",
        "type": "nominal",
        "sort": [
            "Red / Green · RPG origin",
            "First manga chapter",
            "TCG launches in Japan",
            "TV anime begins in Japan",
            "Pokémon Center Tokyo opens",
            "First theatrical film",
            "English TCG Base Set",
            "Pokémon Snap · photography",
            "Mystery Dungeon · roguelike",
            "POKÉMON with YOU",
            "Pokémon GO · location-based",
            "Detective Pikachu · live action",
            "Pokémon UNITE · team battle",
            "Pokémon Concierge · stop-motion",
            "TCG Pocket · digital cards",
            "Pokopia · life simulation"
        ],
        "axis": {
            "title": null,
            "labelFontSize": 11,
            "labelLimit": 235,
            "labelPadding": 10,
            "domain": false,
            "ticks": false
        }
        },
        "opacity": {
        "condition": {
            "test": "categoryFocus === 'All' || datum.category === categoryFocus",
            "value": 1
        },
        "value": 0.13
        },
        "tooltip": [
        {
            "field": "chart_label",
            "type": "nominal",
            "title": "Milestone"
        },
        {
            "field": "category",
            "type": "nominal",
            "title": "Franchise branch"
        },
        {
            "field": "date_label",
            "type": "nominal",
            "title": "Date"
        },
        {
            "field": "description",
            "type": "nominal",
            "title": "Context"
        }
        ]
    },
    "layer": [
        {
        "mark": {
            "type": "circle",
            "size": 185,
            "stroke": "#FFFFFF",
            "strokeWidth": 1.8,
            "cursor": "pointer"
        },
        "encoding": {
            "color": {
            "field": "category",
            "type": "nominal",
            "title": null,
            "scale": {
                "domain": [
                "Original RPG",
                "Manga & print",
                "Trading cards",
                "Screen & animation",
                "Retail & community",
                "Spin-off & mobile"
                ],
                "range": [
                "#17213B",
                "#8D6BC4",
                "#E0A019",
                "#5474D6",
                "#3D9D80",
                "#DB6D8C"
                ]
            },
            "legend": {
                "orient": "bottom",
                "columns": 3,
                "symbolSize": 95,
                "labelFontSize": 11,
                "offset": 15
            }
            }
        }
        },
        {
        "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 11,
            "fontSize": 10,
            "font": "Inter",
            "color": "#62708A"
        },
        "encoding": {
            "text": {
            "field": "year",
            "type": "quantitative",
            "format": ".0f"
            }
        }
        }
    ],
    "config": {
        "font": "Inter",
        "view": {
        "stroke": null
        },
        "axis": {
        "domain": false,
        "tickColor": "#BEC8E0",
        "labelColor": "#52617F",
        "titleColor": "#344063"
        },
        "legend": {
        "labelColor": "#52617F"
        }
    }
}
