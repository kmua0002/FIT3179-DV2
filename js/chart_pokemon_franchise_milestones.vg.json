{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Self-contained selected Pokemon franchise milestones, 1996–2026.",
    "width": 700,
    "height": 560,
    "padding": 10,
    "data": {
        "values": [
        {
            "chart_label": "Red / Green · RPG origin",
            "category": "Original RPG",
            "plot_year": 1996.1557,
            "year": 1996,
            "date_label": "1996-02-27",
            "description": "Original mainline RPG games launch in Japan"
        },
        {
            "chart_label": "First manga chapter",
            "category": "Manga & print",
            "plot_year": 1996.2022,
            "year": 1996,
            "date_label": "1996-03-15",
            "description": "Pocket Monsters manga is first published in CoroCoro Special"
        },
        {
            "chart_label": "TCG launches in Japan",
            "category": "Trading cards",
            "plot_year": 1996.7869,
            "year": 1996,
            "date_label": "Oct 1996",
            "description": "Physical Pokémon TCG launches in Japan"
        },
        {
            "chart_label": "TV anime begins in Japan",
            "category": "Screen & animation",
            "plot_year": 1997.2849,
            "year": 1997,
            "date_label": "Apr 1997",
            "description": "The Pokémon television anime begins broadcasting on TV Tokyo"
        },
        {
            "chart_label": "Pokémon Center Tokyo opens",
            "category": "Retail & community",
            "plot_year": 1998.2849,
            "year": 1998,
            "date_label": "Apr 1998",
            "description": "The first Pokémon Center Tokyo opens in Japan"
        },
        {
            "chart_label": "First theatrical film",
            "category": "Screen & animation",
            "plot_year": 1998.5342,
            "year": 1998,
            "date_label": "Jul 1998",
            "description": "Mewtwo Strikes Back is released theatrically in Japan"
