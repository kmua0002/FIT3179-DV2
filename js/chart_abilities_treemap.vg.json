
{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "description": "Area-proportional treemap of Pokémon Abilities by generation.",
    "width": 720,
    "height": 380,
    "padding": 5,
    "autosize": "pad",
    "background": "transparent",

    "data": [
        {
        "name": "tiles",
        "url": "data/abilities_generation_summary.csv",
        "format": {
            "type": "csv",
            "parse": {
            "generation_number": "number",
            "abilities_introduced": "number",
            "cumulative_abilities": "number",
            "share_of_total_pct": "number"
            }
        },

        "transform": [
            {
            "type": "filter",
            "expr": "datum.abilities_introduced > 0"
            },
            {
            "type": "formula",
            "as": "band",
            "expr": "datum.generation_number <= 5 ? 'top' : 'bottom'"
            },
            {
            "type": "joinaggregate",
            "groupby": ["band"],
            "ops": ["sum"],
            "fields": ["abilities_introduced"],
            "as": ["band_total"]
            },
            {
            "type": "joinaggregate",
            "ops": ["sum"],
            "fields": ["abilities_introduced"],
            "as": ["grand_total"]
            },
            {
            "type": "window",
            "groupby": ["band"],
            "sort": {
                "field": "generation_number",
                "order": "ascending"
            },
            "ops": ["sum"],
            "fields": ["abilities_introduced"],
            "as": ["running_total"]
            },
            {
            "type": "formula",
            "as": "x0",
            "expr": "width * (datum.running_total - datum.abilities_introduced) / datum.band_total + 3"
            },
            {
            "type": "formula",
            "as": "x1",
            "expr": "width * datum.running_total / datum.band_total - 3"
            },
            {
            "type": "formula",
            "as": "y0",
            "expr": "datum.band === 'top' ? 3 : height * (datum.grand_total - datum.band_total) / datum.grand_total + 3"
            },
            {
            "type": "formula",
            "as": "y1",
            "expr": "datum.band === 'top' ? height * datum.band_total / datum.grand_total - 3 : height - 3"
            },
            {
            "type": "formula",
            "as": "center_x",
            "expr": "(datum.x0 + datum.x1) / 2"
            },
            {
            "type": "formula",
            "as": "center_y",
            "expr": "(datum.y0 + datum.y1) / 2"
            },
            {
            "type": "formula",
            "as": "tile_color",
            "expr": "datum.generation_number===3 ? '#FFCB05' : datum.generation_number===4 ? '#3B4CCA' : datum.generation_number===5 ? '#6377D8' : datum.generation_number===6 ? '#B8C4F4' : datum.generation_number===7 ? '#526AD1' : datum.generation_number===8 ? '#9DADEB' : '#23399C'"
            },
            {
            "type": "formula",
            "as": "label_color",
            "expr": "indexof([3,6,8],datum.generation_number)>=0 ? '#17213B' : '#FFFFFF'"
            }
        ]
        }
    ],

    "marks": [
        {
        "type": "rect",
        "from": {"data": "tiles"},
        "encode": {
            "enter": {
            "cornerRadius": {"value": 8}
            },
            "update": {
            "x": {"field": "x0"},
            "x2": {"field": "x1"},
            "y": {"field": "y0"},
            "y2": {"field": "y1"},
            "fill": {"field": "tile_color"},
            "tooltip": {
                "signal": "datum.generation + ': ' + datum.abilities_introduced + ' new Abilities (' + format(datum.share_of_total_pct, '.1f') + '%); cumulative: ' + datum.cumulative_abilities"
            }
            },
            "hover": {
            "stroke": {"value": "#122047"},
            "strokeWidth": {"value": 3}
            }
        }
        },

        {
        "type": "text",
        "from": {"data": "tiles"},
        "interactive": false,
        "encode": {
            "enter": {
            "align": {"value": "center"},
            "baseline": {"value": "middle"},
            "font": {"value": "Inter"},
            "fontSize": {"value": 17},
            "fontWeight": {"value": 700}
            },
            "update": {
            "x": {"field": "center_x"},
            "y": {"signal": "datum.center_y - 35"},
            "text": {"field": "generation"},
            "fill": {"field": "label_color"}
            }
        }
        },

        {
        "type": "text",
        "from": {"data": "tiles"},
        "interactive": false,
        "encode": {
            "enter": {
            "align": {"value": "center"},
            "baseline": {"value": "middle"},
            "font": {"value": "Inter"},
            "fontSize": {"value": 32},
            "fontWeight": {"value": 700}
            },
            "update": {
            "x": {"field": "center_x"},
            "y": {"field": "center_y"},
            "text": {"field": "abilities_introduced"},
            "fill": {"field": "label_color"}
            }
        }
        },

        {
        "type": "text",
        "from": {"data": "tiles"},
        "interactive": false,
        "encode": {
            "enter": {
            "align": {"value": "center"},
            "baseline": {"value": "middle"},
            "font": {"value": "Inter"},
            "fontSize": {"value": 12}
            },
            "update": {
            "x": {"field": "center_x"},
            "y": {"signal": "datum.center_y + 33"},
            "text": {
                "signal": "format(datum.share_of_total_pct, '.1f') + '% of total'"
            },
            "fill": {"field": "label_color"}
            }
        }
        }
    ]
}
